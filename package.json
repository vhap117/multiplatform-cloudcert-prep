{
  "name": "cloudcertprep",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint:dashes": "node scripts/lint-dashes.mjs",
    "verify": "npm run lint:dashes && npm run lint:banks && ng lint && ng test --watch=false && ng build",
    "verify:release": "npm run lint:dashes && npm run lint:banks && ng lint && ng test --watch=false && ng build --configuration production && npm run check:dist",
    "check:dist": "node scripts/check-dist.mjs",
    "lint": "ng lint",
    "lint:banks": "node scripts/check-bank-drift.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/core": "^8.6.0",
    "@ionic/angular": "^9.0.10",
    "lucide-angular": "^1.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/sql.js": "^1.4.11",
    "angular-eslint": "21.4.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.3.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "sql.js": "^1.15.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  }
}
